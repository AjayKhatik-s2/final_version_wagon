# WagonEye v4 -- environment template.
#
# Copy to `.env` on the target machine and fill in the real values. `.env` is
# gitignored; this file is committed and must contain PLACEHOLDERS ONLY.
#
#   cp .env.example .env
#   $EDITOR .env
#
# The pipeline reads plain environment variables, so either export them or have
# your service unit load this file (systemd: `EnvironmentFile=`).

# --- Artifact Upload API --------------------------------------------------
# "api" POSTs every artifact to the backend, which owns the bucket and the
#       object keys -- so this host needs NO AWS credentials for publishing.
# "s3"  writes straight to S3 with the AWS keys below. Current default.
WAGONEYE_ARTIFACT_UPLOAD_MODE=s3

# Endpoint and the X-ML-Upload-Token shared secret. Required when MODE=api;
# the uploader refuses to start in api mode without a token rather than
# discovering it once per file.
WAGONEYE_ARTIFACT_UPLOAD_API_URL=https://ms-pnr-location-notification-api.suvidhaen.com/cctv-receiver/artifacts/upload
WAGONEYE_ARTIFACT_UPLOAD_TOKEN=

# Write straight to S3 when an API upload fails. OFF deliberately: the point of
# api mode is that this host makes no S3 upload calls at all, and a default
# fallback quietly reintroduces the credential requirement. With it off a failed
# upload is a lost artifact, which is loud.
WAGONEYE_ARTIFACT_UPLOAD_FALLBACK_TO_S3=false

# --- Global train ingest --------------------------------------------------
# The fused report is POSTed to the receiver's global endpoint and stored there
# as a virtual fifth camera. UAT only by default: the PROD path returns 404
# (verified 2026-08-28), and posting there anyway logs a failed delivery for
# every train. Set true once the backend confirms PROD is live.
WAGONEYE_GLOBAL_INGEST=true
WAGONEYE_GLOBAL_INGEST_CAMERA_ID=GLOBAL_FUSED
WAGONEYE_GLOBAL_INGEST_ALL_RECEIVERS=false

# --- Per-camera ingest ----------------------------------------------------
# Each camera's provisional document is posted the moment that camera seals,
# then superseded by the fused report. ON by default.
WAGONEYE_PER_CAMERA_INGEST=true

# --- AWS ------------------------------------------------------------------
# Needed only while WAGONEYE_ARTIFACT_UPLOAD_MODE=s3, and for reading input
# videos. Leave blank once uploads move to api mode and inputs are handled
# elsewhere.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WAGONEYE_S3_REGION=ap-south-1
